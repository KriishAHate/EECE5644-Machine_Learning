import numpy as np
import pandas as pd

from sklearn.preprocessing import MinMaxScaler
from sklearn.cluster import KMeans
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    classification_report,
    confusion_matrix,
    precision_score,
    recall_score,
    f1_score,
)

# ============================================================
# 0. Settings
# ============================================================

CSV_PATH = "Filtered dataset/iSUPER_Weather_Underground_merged_2025.csv"
OUTPUT_CSV = "Filtered dataset/fog_predictions_kmeans_top5.csv"

# ============================================================
# 1. Load merged dataset and create fog_label
# ============================================================

df = pd.read_csv(CSV_PATH)

print("Data head:")
display(df.head())

# Build binary fog label: fog if either flag is 1
if ("Dew/Temp fog?" not in df.columns) or ("RH fog?" not in df.columns):
    raise ValueError("Expected columns 'Dew/Temp fog?' and 'RH fog?' not found in dataframe.")

df["fog_label"] = (
    (df["Dew/Temp fog?"] > 0) | (df["RH fog?"] > 0)
).astype(int)

print("\nFog label value counts:")
print(df["fog_label"].value_counts())

# ============================================================
# 2. Define all candidate features and scale
# ============================================================

feature_cols_all = [
    "rh_sensor",
    "temp_sensor",
    "pm1",
    "pm25",
    "pm10",
    "Temperature_C",
    "Dew_Point_C",
    "Humidity_%",
    "Speed_kmh",
    "Pressure_hPa",
    "Precip_Rate_mm",
    "Precip_Accum_mm",
]

missing_feats = [c for c in feature_cols_all if c not in df.columns]
if missing_feats:
    raise ValueError(f"The following expected feature columns are missing: {missing_feats}")

# Drop rows with missing feature values
X_raw_all = df[feature_cols_all].dropna()
y_all = df.loc[X_raw_all.index, "fog_label"]

print(f"\nUsing {X_raw_all.shape[0]} samples and {X_raw_all.shape[1]} features.")

# Scale features to [0,1]
scaler_all = MinMaxScaler()
X_all = scaler_all.fit_transform(X_raw_all)

# ============================================================
# 3. Random Forest for feature importance (supervised)
# ============================================================

rf = RandomForestClassifier(
    n_estimators=200,
    random_state=42,
    n_jobs=-1,
)
rf.fit(X_all, y_all)

feature_importance = pd.DataFrame(
    {
        "feature": feature_cols_all,
        "importance": rf.feature_importances_,
    }
).sort_values("importance", ascending=False)

print("\n=== Feature Importance Ranking ===")
display(feature_importance)

# Choose top N most important features
top_n = 5
top_features = feature_importance["feature"].head(top_n).tolist()
print(f"\nUsing top {top_n} features for clustering: {top_features}")

# ============================================================
# 4. Rebuild dataset with only top features + scale
# ============================================================

X_raw_selected = df[top_features].dropna()
y_selected = df.loc[X_raw_selected.index, "fog_label"]

print(f"\nSelected-feature dataset shape: {X_raw_selected.shape}")

scaler_selected = MinMaxScaler()
X_selected = scaler_selected.fit_transform(X_raw_selected)

# ============================================================
# 5. K-Means (k=2) on selected features
# ============================================================

kmeans = KMeans(
    n_clusters=2,
    random_state=42,
    n_init=10,
)
kmeans.fit(X_selected)
clusters = kmeans.labels_

# Decide which cluster is "fog" based on majority vote from fog_label
cluster0_mean = y_selected[clusters == 0].mean()
cluster1_mean = y_selected[clusters == 1].mean()
fog_cluster = 0 if cluster0_mean > cluster1_mean else 1

print("\nCluster mean fog_label:")
print(f"Cluster 0: {cluster0_mean:.3f}")
print(f"Cluster 1: {cluster1_mean:.3f}")
print(f"Chosen fog cluster: {fog_cluster}")

# ============================================================
# 6. Convert K-Means distances to fog score in [0,1]
# ============================================================

distances = kmeans.transform(X_selected)
fog_distance = distances[:, fog_cluster]
max_dist = fog_distance.max()

# Simple "fog score": closer to fog cluster center => higher score
fog_score = 1.0 - (fog_distance / max_dist)
fog_score_series = pd.Series(fog_score, index=X_raw_selected.index)

print("\nFog score summary:")
display(fog_score_series.describe())

# ============================================================
# 7. Scan thresholds and pick best F1 for fog class
# ============================================================

thresholds = np.linspace(0.3, 0.7, 20)  # adjust range if you want
best_f1 = 0.0
best_threshold = 0.5
results = []

for thresh in thresholds:
    y_pred = (fog_score_series > thresh).astype(int)

    precision = precision_score(y_selected, y_pred, zero_division=0)
    recall = recall_score(y_selected, y_pred, zero_division=0)
    f1 = f1_score(y_selected, y_pred, zero_division=0)

    results.append(
        {"threshold": thresh, "precision": precision, "recall": recall, "f1": f1}
    )

    if f1 > best_f1:
        best_f1 = f1
        best_threshold = thresh

results_df = pd.DataFrame(results)

print("\n=== Threshold scan results (first 5 rows) ===")
display(results_df.head())

print(f"\nBest threshold: {best_threshold:.3f}")
print(f"Best F1-score (fog class): {best_f1:.3f}")

# ============================================================
# 8. Final evaluation at best threshold
# ============================================================

y_pred_opt = (fog_score_series > best_threshold).astype(int)

cm = confusion_matrix(y_selected, y_pred_opt)
print("\n=== Confusion Matrix (rows=true, cols=pred) ===")
print(cm)

print("\n=== Classification Report (optimized K-Means, top 5 features) ===")
print(classification_report(y_selected, y_pred_opt, digits=3))

# ============================================================
# 9. Attach predictions back to dataframe and save
# ============================================================

results_df_full = df.loc[X_raw_selected.index].copy()

# If timestamp_utc exists, keep it; otherwise skip
if "timestamp_utc" in results_df_full.columns:
    keep_cols = ["timestamp_utc"]
else:
    keep_cols = []

results_df_full = results_df_full[keep_cols] if keep_cols else pd.DataFrame(index=X_raw_selected.index)
results_df_full["fog_score_kmeans"] = fog_score_series
results_df_full["fog_pred_kmeans"] = y_pred_opt
results_df_full["fog_label"] = y_selected.values

print("\nPreview of saved predictions:")
display(results_df_full.head())

results_df_full.to_csv(OUTPUT_CSV, index=False)
print(f"\nSaved fog predictions to: {OUTPUT_CSV}")

